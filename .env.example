# ============================================================================
# CONFIGURACIÓN OPCIONAL DE API KEYS PARA TESTNET / DEMO EXTERNO
# ============================================================================
# Si no completas este archivo, el agente opera automáticamente usando el
# Broker Local de Paper Trading En Vivo (precios reales al segundo de Binance
# y Yahoo Finance, guardando tu cuenta en `live_portfolio.json`).
#
# Si deseas replicar las órdenes hacia Binance Testnet u OANDA Forex Demo:
# 1. Copia este archivo como `.env`
# 2. Pega tus claves de prueba gratuitas abajo:

# --- BINANCE TESTNET (Cripto: https://testnet.binancefuture.com) ---
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- OANDA FOREX DEMO (Forex: https://www.oanda.com/demo-account/) ---
OANDA_DEMO_API_TOKEN=
OANDA_DEMO_ACCOUNT_ID=
